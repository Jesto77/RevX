<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Parameter Manager"
    Width="1320" Height="820"
    MinWidth="1000" MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#FFF5F7FA"
    Foreground="#FF2C3E50"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"     Color="#FF2196F3"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF1976D2"/>
        <SolidColorBrush x:Key="SuccessBrush"     Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="DangerBrush"      Color="#FFE53935"/>
        <SolidColorBrush x:Key="WarningBrush"     Color="#FFFF9800"/>
        <SolidColorBrush x:Key="TextBrush"        Color="#FF2C3E50"/>
        <SolidColorBrush x:Key="LightGrayBrush"   Color="#FFECEFF1"/>
        <SolidColorBrush x:Key="BorderBrush"      Color="#FFCFD8DC"/>
        <SolidColorBrush x:Key="MutedTextBrush"   Color="#FF607D8B"/>

        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFBBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFB0BEC5"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background"  Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"  Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"  Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"  Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="AppTextBox" TargetType="TextBox">
            <Setter Property="Background"              Value="White"/>
            <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="8,6"/>
            <Setter Property="Margin"                  Value="3"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="MinHeight"               Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AppComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="MinHeight"       Value="30"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin"     Value="3,4,3,2"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="4,10,4,6"/>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="12"/>
            <Setter Property="Margin"          Value="5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding"    Value="18,10"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Margin="1,0,1,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="Padding"                    Value="10,8"/>
            <Setter Property="FontWeight"                 Value="Bold"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="BorderBrush"                Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="BorderThickness"            Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFBBDEFB"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="MinHeight"  Value="32"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFAFAFA"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding"                    Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="2"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="26" VerticalAlignment="Center"
                               Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Parameter Manager" FontSize="20"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄  Refresh" Click="OnRefresh"
                            Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                            BorderBrush="White" Padding="16,7" Margin="4"
                            FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="✕  Close" Click="OnClose"
                            Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                            BorderBrush="White" Padding="16,7" Margin="4"
                            FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <TabControl Grid.Row="1"
                    Background="{StaticResource LightGrayBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Margin="0" Padding="0">

            <!-- TAB 1: PROJECT PARAMETERS -->
            <TabItem Header="📋  Project Parameters">
                <Grid Margin="6" Background="{StaticResource LightGrayBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔍  Search" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="searchBox" Style="{StaticResource AppTextBox}"
                                         TextChanged="OnSearchChanged"
                                         ToolTip="Search by name, category, type or GUID"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="sourceFilterCombo" Style="{StaticResource AppComboBox}"
                                          SelectionChanged="OnFilterChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Binding" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="instanceTypeCombo" Style="{StaticResource AppComboBox}"
                                          SelectionChanged="OnFilterChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="paramGroupCombo" Style="{StaticResource AppComboBox}"
                                          SelectionChanged="OnFilterChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="paramTypeCombo" Style="{StaticResource AppComboBox}"
                                          SelectionChanged="OnFilterChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="countText" Grid.Column="5"
                                       VerticalAlignment="Bottom"
                                       Margin="12,0,6,10" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="6">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="☑  Select All" Style="{StaticResource AppButton}" Click="OnSelectAll"/>
                            <Button Content="☐  Select None" Style="{StaticResource AppButton}" Click="OnSelectNone"/>
                            <Button Content="🔀  Invert" Style="{StaticResource AppButton}" Click="OnInvertSelection"/>
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,4"/>
                            <Button Content="🗑  Delete Selected" Style="{StaticResource DangerButton}" Click="OnDeleteSelected"/>
                            <Button Content="⬇  Load Categories" Style="{StaticResource AppButton}" Click="OnShowParamCategories"
                                    ToolTip="Load selected parameter categories into Edit tab"/>
                            <Button Content="👁  View Categories" Style="{StaticResource AppButton}" Click="OnViewCategoriesDialog"
                                    ToolTip="Show all categories of selected parameter in a popup"/>
                            <Button Content="✏  Edit Parameter" Style="{StaticResource PrimaryButton}" Click="OnEditParameter"
                                    ToolTip="Open edit dialog for selected parameter"/>
                            <Button Content="🔄  Toggle Inst/Type" Style="{StaticResource PrimaryButton}" Click="OnToggleInstanceType"/>
                            <Button Content="🧹  Purge Unused" Style="{StaticResource WarningButton}" Click="OnPurgeUnused"/>
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,4"/>
                            <Button Content="📤  Export CSV" Style="{StaticResource SuccessButton}" Click="OnExportCSV"/>
                            <Button Content="📤  Export JSON" Style="{StaticResource SuccessButton}" Click="OnExportJSON"/>
                            <Button Content="📥  Import CSV" Style="{StaticResource AppButton}" Click="OnImportCSV"/>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
                        <DataGrid x:Name="paramDataGrid"
                                  AutoGenerateColumns="False"
                                  Background="White"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeader}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Visible">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="✓" Width="45" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ParameterType}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding ParameterGroup}" Width="160" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Instance" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsInstance}" IsEnabled="False" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Shared" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsShared}" IsEnabled="False" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="GUID" Binding="{Binding GUID}" Width="260" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Categories" Width="400" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Categories}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding Categories}"
                                                       Padding="4,2"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ADD PARAMETER -->
            <TabItem Header="➕  Add Parameter">
                <Grid Margin="6" Background="{StaticResource LightGrayBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Parameter Settings -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📝 New Parameter Settings" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Parameter Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="addParamNameBox" Style="{StaticResource AppTextBox}" FontSize="14"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Parameter Group" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="addParamGroupCombo" Style="{StaticResource AppComboBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Parameter Type" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="addParamTypeCombo" Style="{StaticResource AppComboBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Binding Type" Style="{StaticResource FieldLabel}" Margin="3,14,3,4"/>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <RadioButton x:Name="addInstanceRadio" Content="Instance"
                                                 IsChecked="True" Margin="0,0,25,0" GroupName="BindingType"/>
                                    <RadioButton x:Name="addTypeRadio" Content="Type" GroupName="BindingType"/>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,10"/>

                                <Button Content="➕  Add as Project Parameter"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OnAddProjectParam"
                                        FontSize="14" Padding="22,10"
                                        HorizontalAlignment="Left"/>

                                <Border Background="#FFFFF8E1" BorderBrush="#FFFFE082" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="3,14,3,3">
                                    <TextBlock TextWrapping="Wrap" Foreground="#FF7C6F00" FontSize="12">
                                        💡 <Run FontWeight="Bold">Tip:</Run>
                                        Enter a name, choose a Group + Type, tick one or more
                                        Categories on the right, then click "Add as Project Parameter".
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Category Selection -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📁 Categories *"
                                       Style="{StaticResource SectionHeader}"/>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="Select All" Style="{StaticResource AppButton}"
                                        Click="OnSelectAllCategories" Padding="10,4"/>
                                <Button Content="Clear All" Style="{StaticResource AppButton}"
                                        Click="OnSelectNoCategories" Padding="10,4"/>
                            </StackPanel>

                            <TextBox x:Name="categorySearchBox" DockPanel.Dock="Top"
                                     Style="{StaticResource AppTextBox}"
                                     TextChanged="OnSearchCategories"
                                     ToolTip="Search categories..."/>

                            <Border Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Margin="3">
                                <ScrollViewer VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="categoryList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: EDIT CATEGORIES -->
            <TabItem Header="✏  Edit Categories">
                <Grid Margin="6" Background="{StaticResource LightGrayBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Category picker -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📁 Category Panel"
                                       Style="{StaticResource SectionHeader}"/>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="All" Style="{StaticResource AppButton}"
                                        Click="OnSelectAllCategories" Padding="10,4"/>
                                <Button Content="None" Style="{StaticResource AppButton}"
                                        Click="OnSelectNoCategories" Padding="10,4"/>
                            </StackPanel>

                            <TextBox x:Name="editCategorySearchBox" DockPanel.Dock="Top"
                                     Style="{StaticResource AppTextBox}"
                                     TextChanged="OnSearchEditCategories"
                                     ToolTip="Search categories..."/>

                            <TextBlock x:Name="editCatCountLabel" DockPanel.Dock="Bottom"
                                       FontSize="11" Margin="4,4,4,0"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <Border Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Margin="3">
                                <ScrollViewer VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="editCategoryList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Right: Actions + Presets -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Category Actions -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="🔧 Category Actions" Style="{StaticResource SectionHeader}"/>

                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" Margin="3,0,3,8">
                                        Select parameters in the Project Parameters tab (tick checkboxes),
                                        then use the buttons below.
                                    </TextBlock>

                                    <Button Content="⬇  Load Selected Parameter's Categories"
                                            Style="{StaticResource AppButton}"
                                            Click="OnShowParamCategories"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"
                                            ToolTip="Pre-check categories currently assigned to selected parameter"/>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>

                                    <Button Content="↔  Replace Categories (checked = new full set)"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnModifyCategories"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"
                                            ToolTip="Remove all current categories and assign only the checked ones"/>

                                    <Button Content="➕  Add Checked Categories (keep existing)"
                                            Style="{StaticResource SuccessButton}"
                                            Click="OnAddCategoriesToSelected"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"
                                            ToolTip="Merge checked categories with existing"/>

                                    <Button Content="➖  Remove Checked Categories (keep rest)"
                                            Style="{StaticResource DangerButton}"
                                            Click="OnRemoveCategoriesFromSelected"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"
                                            ToolTip="Remove only the checked categories"/>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>

                                    <Button Content="⇄  Toggle Instance / Type (selected params)"
                                            Style="{StaticResource WarningButton}"
                                            Click="OnToggleInstanceType"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"/>

                                    <Button Content="✏  Open Detailed Edit Dialog (single param)"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnEditParameter"
                                            HorizontalAlignment="Stretch" Margin="3,2" Height="34"
                                            ToolTip="Full edit dialog for one parameter"/>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="💾 Category Presets" Style="{StaticResource SectionHeader}"/>

                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" Margin="3,0,3,8">
                                        Save a named set of categories to apply to many parameters in one click.
                                    </TextBlock>

                                    <TextBlock Text="Preset Name" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="presetNameBox" Grid.Column="0"
                                                 Style="{StaticResource AppTextBox}"
                                                 ToolTip="Name for the new preset"/>
                                        <Button Grid.Column="1" Content="💾 Save"
                                                Style="{StaticResource SuccessButton}"
                                                Click="OnSavePreset"
                                                ToolTip="Save checked categories as a preset"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>

                                    <TextBlock Text="Select Preset" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="presetCombo" Style="{StaticResource AppComboBox}"/>

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Load into Panel" Style="{StaticResource AppButton}"
                                                Click="OnLoadPreset"
                                                ToolTip="Check preset categories in the category panel"/>
                                        <Button Content="Apply to Selected Params" Style="{StaticResource PrimaryButton}"
                                                Click="OnApplyPresetToSelected"
                                                ToolTip="Apply preset categories directly to ticked parameters"/>
                                        <Button Content="🗑 Delete Preset" Style="{StaticResource DangerButton}"
                                                Click="OnDeletePreset"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: SHARED PARAMETERS -->
            <TabItem Header="🔗  Shared Parameters">
                <Grid Margin="6" Background="{StaticResource LightGrayBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Shared Parameter Tree -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📂 Shared Parameter File"
                                       Style="{StaticResource SectionHeader}"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="sharedFilePathText" Grid.Column="0"
                                         Style="{StaticResource AppTextBox}" IsReadOnly="True"
                                         Text="No file loaded" Background="#FFF5F5F5"/>
                                <Button Grid.Column="1" Content="📂  Browse"
                                        Style="{StaticResource AppButton}" Click="OnBrowseSharedFile"/>
                                <Button Grid.Column="2" Content="✨  New"
                                        Style="{StaticResource SuccessButton}" Click="OnCreateSharedFile"/>
                            </Grid>

                            <Border Grid.Row="2" Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Margin="3">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TreeView x:Name="sharedParamTree"
                                              Background="Transparent" BorderThickness="0"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="➕  Add Selected to Project"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OnAddSharedToProject" FontSize="13" Padding="18,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Create Shared Parameters -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="✏️ Create Shared Parameters"
                                           Style="{StaticResource SectionHeader}"/>

                                <Border Background="#FFF5F7FA" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="📁 New Group" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="newSharedGroupBox" Style="{StaticResource AppTextBox}"/>
                                        <Button Content="Create Group" Style="{StaticResource PrimaryButton}"
                                                Click="OnAddSharedGroup" HorizontalAlignment="Left" Margin="3,6,3,3"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF5F7FA" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="3,10,3,3">
                                    <StackPanel>
                                        <TextBlock Text="📋 New Shared Parameter" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="sharedGroupCombo" Style="{StaticResource AppComboBox}"/>
                                        <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="newSharedParamNameBox" Style="{StaticResource AppTextBox}"/>
                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="newSharedParamDescBox" Style="{StaticResource AppTextBox}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                   FontStyle="Italic" Margin="3,4,3,4" TextWrapping="Wrap"
                                                   Text="Type uses the selection from Add Parameter tab"/>
                                        <Button Content="➕  Create Shared Parameter"
                                                Style="{StaticResource SuccessButton}"
                                                Click="OnAddSharedParam" Margin="3,6,3,3"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: PARAMETER VALUES -->
            <TabItem Header="📊  Parameter Values">
                <Grid Margin="6" Background="{StaticResource LightGrayBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="📊 Parameter Values" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                                           Text="Select elements in Revit and click Read to load parameter values"/>
                                <Button Grid.Column="1" Content="📖  Read Values"
                                        Style="{StaticResource PrimaryButton}" Click="OnReadValues"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="3,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Parameter Name:"
                                           VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" x:Name="writeParamNameBox" Style="{StaticResource AppTextBox}"/>
                                <TextBlock Grid.Column="2" Text="Value:"
                                           VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="3" x:Name="writeParamValueBox" Style="{StaticResource AppTextBox}"/>
                                <Button Grid.Column="4" Content="✏️  Write Values"
                                        Style="{StaticResource SuccessButton}" Click="OnWriteValues"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
                        <DataGrid x:Name="valueDataGrid"
                                  AutoGenerateColumns="False"
                                  Background="White"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  CanUserSortColumns="True"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeader}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Element" Binding="{Binding Source}" Width="280"/>
                                <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ParameterType}" Width="140"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                <DataGridTemplateColumn Header="Has Value" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding HasValue}" IsEnabled="False"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: ABOUT -->
            <TabItem Header="ℹ️  About">
                <Grid Background="{StaticResource LightGrayBrush}">
                    <Border Style="{StaticResource CardPanel}" MaxWidth="640"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="⚙" FontSize="64" HorizontalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,10"/>
                            <TextBlock Text="Parameter Manager" FontSize="28" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Version 1.2.0" FontSize="14" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4"/>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="20,18"/>

                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" Margin="20,0"
                                       Text="A comprehensive parameter management tool for Autodesk Revit. Manage project parameters, shared parameters, parameter values, and more. Compatible with Revit 2019 through 2025+."/>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="20,18"/>

                            <TextBlock TextWrapping="Wrap" TextAlignment="Left"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" Margin="30,0">
                                <Run FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}">Features:</Run>
                                <LineBreak/>
                                <Run Text="✓ View, filter and search all parameters"/>
                                <LineBreak/>
                                <Run Text="✓ Add new project parameters with category binding"/>
                                <LineBreak/>
                                <Run Text="✓ Edit categories: replace / add / remove"/>
                                <LineBreak/>
                                <Run Text="✓ Save and apply category presets"/>
                                <LineBreak/>
                                <Run Text="✓ Detailed single-parameter edit dialog"/>
                                <LineBreak/>
                                <Run Text="✓ Manage shared parameter files"/>
                                <LineBreak/>
                                <Run Text="✓ Create shared parameter groups and definitions"/>
                                <LineBreak/>
                                <Run Text="✓ Add shared parameters to project"/>
                                <LineBreak/>
                                <Run Text="✓ Delete and modify existing parameters"/>
                                <LineBreak/>
                                <Run Text="✓ Toggle Instance/Type binding"/>
                                <LineBreak/>
                                <Run Text="✓ Read and write parameter values"/>
                                <LineBreak/>
                                <Run Text="✓ Export to CSV / JSON"/>
                                <LineBreak/>
                                <Run Text="✓ Import parameters from CSV"/>
                                <LineBreak/>
                                <Run Text="✓ Purge unused parameters"/>
                            </TextBlock>

                            <TextBlock Text="Built with pyRevit" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,20,0,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryDarkBrush}" Padding="10,5">
            <TextBlock x:Name="statusText" Text="Ready"
                       Foreground="White" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>