<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Custom File Name" Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        MinHeight="480" MinWidth="700"
        ShowInTaskbar="False"
        Background="#FFF0F0F0"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#FFC8C8C8"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFDFDFD"/>
            <Setter Property="BorderBrush" Value="#FFADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE8F1FB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF5B9BD5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFCFE3F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFF4F4F4"/>
                                <Setter Property="Foreground" Value="#FFA0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10"
                   Text="Build the file name from parameters. The order of the selected list is the order used in the name."
                   TextWrapping="Wrap" Foreground="#FF505050"/>

        <!-- ================= PICKER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Available parameters" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtParamSearch" DockPanel.Dock="Top" Height="24" Margin="0,0,0,4"
                         VerticalContentAlignment="Center" ToolTip="Filter the list"/>
                <ListBox x:Name="LstAvailable" SelectionMode="Extended"
                         BorderBrush="{StaticResource LineBrush}" Background="White"/>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button x:Name="BtnAddParam" Style="{StaticResource ArrowButton}"
                        Content="&#x25B6;" ToolTip="Add selected parameter(s)"/>
                <Button x:Name="BtnRemoveParam" Style="{StaticResource ArrowButton}"
                        Content="&#x25C0;" ToolTip="Remove selected parameter(s)"/>
            </StackPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Selected parameters (in order)" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <Border DockPanel.Dock="Top" Height="24" Margin="0,0,0,4" Background="Transparent"/>
                <ListBox x:Name="LstSelected" SelectionMode="Extended"
                         BorderBrush="{StaticResource LineBrush}" Background="White"/>
            </DockPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="BtnParamUp" Style="{StaticResource ArrowButton}"
                        Content="&#x25B2;" ToolTip="Move up"/>
                <Button x:Name="BtnParamDown" Style="{StaticResource ArrowButton}"
                        Content="&#x25BC;" ToolTip="Move down"/>
            </StackPanel>
        </Grid>

        <!-- ================= OPTIONS ================= -->
        <GroupBox Grid.Row="2" Header="Options" Margin="0,12,0,0">
            <WrapPanel>
                <TextBlock Text="Separator" VerticalAlignment="Center" Margin="0,4,4,4"/>
                <ComboBox x:Name="CmbSeparator" Width="80" Height="24" SelectedIndex="1" IsEditable="True"
                          Margin="0,4,0,4">
                    <sys:String>-</sys:String>
                    <sys:String>_</sys:String>
                    <sys:String> </sys:String>
                    <sys:String>.</sys:String>
                    <sys:String>none</sys:String>
                </ComboBox>
                <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="16,4,4,4"/>
                <TextBox x:Name="TxtPrefix" Width="130" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Text="Suffix" VerticalAlignment="Center" Margin="16,4,4,4"/>
                <TextBox x:Name="TxtSuffix" Width="130" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>
                <CheckBox x:Name="ChkRemoveSpaces" Content="Remove spaces" VerticalAlignment="Center" Margin="18,4,0,4"/>
                <CheckBox x:Name="ChkUppercase" Content="UPPERCASE" VerticalAlignment="Center" Margin="14,4,0,4"/>
                <CheckBox x:Name="ChkSanitize" Content="Fix illegal chars" IsChecked="True"
                          VerticalAlignment="Center" Margin="14,4,0,4"/>
            </WrapPanel>
        </GroupBox>

        <!-- ================= PREVIEW ================= -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" Background="White"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preview:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtNamePreview" Foreground="#FF1B5E20" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- ================= FOOTER ================= -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSaveXml" Style="{StaticResource FlatButton}" Content="Save XML..."
                        Margin="0,0,6,0" ToolTip="Save this naming rule to an XML file of your choice"/>
                <Button x:Name="BtnLoadXml" Style="{StaticResource FlatButton}" Content="Load XML..."
                        ToolTip="Load a naming rule from an XML file"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelNaming" Style="{StaticResource FlatButton}" Content="Cancel"
                        MinWidth="90" Margin="0,0,6,0" IsCancel="True"/>
                <Button x:Name="BtnApplyNaming" Style="{StaticResource FlatButton}" Content="Apply"
                        MinWidth="110" FontWeight="SemiBold" IsDefault="True"
                        ToolTip="Apply this rule to the Custom File Name column and close"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
