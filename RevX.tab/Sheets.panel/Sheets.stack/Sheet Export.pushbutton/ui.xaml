<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Sheet Export" Height="830" Width="1240"
        WindowStartupLocation="CenterScreen"
        MinHeight="640" MinWidth="1000"
        ResizeMode="CanResize"
        Background="#FFF0F0F0"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>

        <!-- ============ CONVERTERS / SHARED BRUSHES ============ -->
        <SolidColorBrush x:Key="PanelBg" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="GridHeaderBg" Color="#FFE9E9E9"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFC8C8C8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF3FA34D"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFF0A32E"/>

        <!-- ============ BUTTONS ============ -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFDFDFD"/>
            <Setter Property="BorderBrush" Value="#FFADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE8F1FB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF5B9BD5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFCFE3F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFF4F4F4"/>
                                <Setter Property="Foreground" Value="#FFA0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="GreenTag" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2E7D3A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="OrangeTag" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC98211"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- ============ TABS ============ -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBd" Margin="0,0,2,0"
                                Background="#FFE1E1E1" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="White"/>
                                <Setter TargetName="tabBd" Property="Margin" Value="0,0,2,-1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBd" Property="Background" Value="#FFEDEDED"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ DATAGRID ============ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource GridHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFD6E8FA"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#FF303030"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>

        <Style x:Key="Row" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="*"/>
            <!-- tabs -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Margin="2,2,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sheet Export" FontSize="18" FontWeight="Bold" Foreground="#FF202020"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtVersion" Text="  v1.0" FontSize="11" Foreground="#FF808080"
                           VerticalAlignment="Bottom" Margin="2,0,0,3"/>
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="TxtDocName" Text="" Foreground="#FF606060"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Naming rule" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbProfile" Width="200" Height="24" VerticalContentAlignment="Center"
                          ToolTip="Switch between saved naming rules (XML files)"/>
                <Button x:Name="BtnProfileSave" Style="{StaticResource TinyButton}" Content="Save as..."
                        Margin="4,0,0,0" Height="24"
                        ToolTip="Save the current naming rule as a new XML in the rules folder"/>
                <Button x:Name="BtnProfileBrowse" Style="{StaticResource TinyButton}" Content="Load..."
                        Margin="3,0,0,0" Height="24"
                        ToolTip="Load a naming rule XML from anywhere on disk"/>
                <Button x:Name="BtnProfileFolder" Style="{StaticResource TinyButton}" Content="📂"
                        Margin="3,0,0,0" Width="28" Height="24"
                        ToolTip="Open the rules folder"/>
                <Button x:Name="BtnProfileDelete" Style="{StaticResource TinyButton}" Content="🗑"
                        Margin="3,0,0,0" Width="28" Height="24"
                        ToolTip="Delete the selected rule"/>
            </StackPanel>
        </Grid>

        <!-- ==================== TABS ==================== -->
        <TabControl x:Name="Tabs" Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="0">

            <!-- ============================================================ -->
            <!-- TAB 1 : SELECTION                                            -->
            <!-- ============================================================ -->
            <TabItem Header="Selection">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbSheets" Content="Sheets" IsChecked="True"
                                         GroupName="Mode" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbViews" Content="Views" GroupName="Mode"
                                         VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="View/Sheet Set" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbVSSet" Width="180" Height="24" VerticalContentAlignment="Center"
                                      ToolTip="Filter by View/Sheet Set"/>
                            <Button x:Name="BtnSaveVSSet" Style="{StaticResource FlatButton}"
                                    Content="Save V/S Set" Margin="8,0,0,0" Height="24"
                                    ToolTip="Save current selection as a Revit View/Sheet Set"/>
                            <CheckBox x:Name="ChkGroupSeries" Content="Group by"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="Organise the grid into groups using the chosen parameter, same as the Project Browser"/>
                            <ComboBox x:Name="CmbGroupParam" Width="150" Height="24"
                                      Margin="6,0,0,0" VerticalContentAlignment="Center"
                                      ToolTip="Parameter to group rows by (defaults to 'Series Range' if present)"/>
                        </StackPanel>

                        <Grid Grid.Column="2" Width="230">
                            <TextBox x:Name="TxtSearch" Height="24" VerticalContentAlignment="Center"
                                     Padding="6,0,22,0"/>
                            <TextBlock Text="Search..." Foreground="#FF9A9A9A" Margin="8,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Foreground="#FF707070" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- grid -->
                    <DataGrid x:Name="GridItems" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#FFDCDCDC"
                              VerticalGridLinesBrush="#FFDCDCDC"
                              RowHeight="26"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              AlternatingRowBackground="#FFFAFAFA"
                              Background="White"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <!-- Fully custom template: the stock Expander chrome drew its
                                                         own arrow glyph UNDER our header band (the negative Margin
                                                         pulled the band left, straight under it), which is what
                                                         caused the visual clash. Everything below is laid out in
                                                         one Grid so nothing overlaps, and the arrow + tick box are
                                                         real, separate hit targets. -->
                                                    <Expander IsExpanded="True" BorderThickness="0" Background="Transparent">
                                                        <Expander.Template>
                                                            <ControlTemplate TargetType="{x:Type Expander}">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Top" Background="#FFE0ECF7"
                                                                            BorderBrush="{StaticResource LineBrush}"
                                                                            BorderThickness="0,0,0,1" Padding="4,4" Margin="-6,0,0,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="22"/>
                                                                                <ColumnDefinition Width="34"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- expand / collapse arrow -->
                                                                            <ToggleButton Grid.Column="0"
                                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                                          Focusable="False" Width="16" Height="16"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          ToolTip="Expand / collapse this series">
                                                                                <ToggleButton.Template>
                                                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                                        <Border Background="Transparent">
                                                                                            <Path x:Name="Arrow" Fill="#FF1B3B61" Stretch="Uniform"
                                                                                                  Width="9" Height="9" HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Data="M 0 0 L 8 4 L 0 8 Z"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 8 Z"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </ToggleButton.Template>
                                                                            </ToggleButton>

                                                                            <!-- select / clear every sheet in this series -->
                                                                            <CheckBox Grid.Column="1" x:Name="ChkSeriesAll"
                                                                                      Tag="{Binding}" IsThreeState="True"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      ToolTip="Select / clear every sheet in this series"/>

                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="Series: " FontWeight="SemiBold" Foreground="#FF1B3B61"/>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF1B3B61"/>
                                                                                <TextBlock Text=" (" Foreground="#FF1B3B61" Margin="4,0,0,0"/>
                                                                                <TextBlock Text="{Binding ItemCount}" Foreground="#FF1B3B61"/>
                                                                                <TextBlock Text=" items)" Foreground="#FF1B3B61"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ContentPresenter x:Name="SeriesContent" DockPanel.Dock="Bottom"/>
                                                                </DockPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsExpanded" Value="False">
                                                                        <Setter TargetName="SeriesContent" Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Expander.Template>
                                                        <Expander.Content>
                                                            <ItemsPresenter/>
                                                        </Expander.Content>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkAll" HorizontalAlignment="Center"
                                              ToolTip="Select / clear all visible rows"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding Number}"
                                                Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding Name}"
                                                Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Revision" Binding="{Binding Revision}"
                                                Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}"
                                                Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Custom File Name" Binding="{Binding CustomFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- under-grid options -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BtnSelAll" Style="{StaticResource TinyButton}" Content="Select all" Margin="0,0,4,0"/>
                            <Button x:Name="BtnSelNone" Style="{StaticResource TinyButton}" Content="Clear" Margin="0,0,4,0"/>
                            <Button x:Name="BtnSelInvert" Style="{StaticResource TinyButton}" Content="Invert" Margin="0,0,4,0"/>
                            <Button x:Name="BtnResetNames" Style="{StaticResource TinyButton}" Content="Reset file names"
                                    ToolTip="Rebuild the Custom File Name column from the current naming rule"/>
                            <Border Width="1" Background="#FFC8C8C8" Margin="8,2"/>
                            <Button x:Name="BtnNaming" Style="{StaticResource FlatButton}"
                                    Content="Custom File Name..." FontWeight="SemiBold" Height="24"
                                    ToolTip="Open the file naming builder"/>
                            <TextBlock x:Name="TxtRuleSummary" Text="" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="#FF1B5E20" FontSize="11"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkOnlyActive" Content="Show only active Sheets/Views"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- footer -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatusSel" Grid.Column="0" VerticalAlignment="Center"
                                   Text="0 sheets and 0 views selected. Total: 0" Foreground="#FF404040"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnReload" Style="{StaticResource FlatButton}" Content="⟳"
                                    Width="30" ToolTip="Reload sheets / views from model" Margin="0,0,6,0"/>
                            <Button x:Name="BtnNext1" Style="{StaticResource NavButton}" Content="Next"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2 : FORMAT                                               -->
            <!-- ============================================================ -->
            <TabItem Header="Format">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- format checklist -->
                            <GroupBox Grid.Column="0" Header="Export formats" Margin="0,0,8,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPDF" Style="{StaticResource Row}" Content="PDF" IsChecked="True"/>
                                    <CheckBox x:Name="ChkDWG" Style="{StaticResource Row}" Content="DWG"/>
                                    <CheckBox x:Name="ChkDGN" Style="{StaticResource Row}" Content="DGN"/>
                                    <CheckBox x:Name="ChkDWF" Style="{StaticResource Row}" Content="DWF"/>
                                    <CheckBox x:Name="ChkNWC" Style="{StaticResource Row}" Content="NWC"/>
                                    <CheckBox x:Name="ChkIFC" Style="{StaticResource Row}" Content="IFC"/>
                                    <CheckBox x:Name="ChkIMG" Style="{StaticResource Row}" Content="IMG (PNG/JPG)"/>
                                    <Separator Margin="0,8"/>
                                    <TextBlock Text="Tip: several formats can be exported in one run."
                                               TextWrapping="Wrap" Foreground="#FF707070" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- settings per format -->
                            <TabControl Grid.Column="1" x:Name="FmtTabs" BorderBrush="{StaticResource LineBrush}"
                                        Background="White">

                                <!-- ===== PDF ===== -->
                                <TabItem Header="PDF">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <GroupBox Header="Paper placement">
                                                    <StackPanel>
                                                        <RadioButton x:Name="RbCenter" GroupName="PdfPlace"
                                                                     Content="Center" Margin="0,3"/>
                                                        <RadioButton x:Name="RbOffset" GroupName="PdfPlace"
                                                                     Content="Offset from corner" IsChecked="True" Margin="0,3"/>
                                                        <ComboBox x:Name="CmbMargin" Height="24" Margin="18,3,0,3"
                                                                  SelectedIndex="0"
                                                                  IsEnabled="{Binding IsChecked, ElementName=RbOffset}">
                                                            <sys:String>No Margin</sys:String>
                                                            <sys:String>Printer Limit</sys:String>
                                                            <sys:String>User Defined</sys:String>
                                                        </ComboBox>
                                                        <StackPanel Orientation="Horizontal" Margin="18,3,0,0">
                                                            <TextBlock Text="Margin" VerticalAlignment="Center"
                                                                       Width="48"/>
                                                            <TextBox x:Name="TxtMargin" Text="0" Width="56" Height="22"
                                                                     VerticalContentAlignment="Center"
                                                                     IsEnabled="{Binding IsChecked, ElementName=RbOffset}"/>
                                                            <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Zoom">
                                                    <StackPanel>
                                                        <RadioButton x:Name="RbFitToPage" GroupName="PdfZoom"
                                                                     Content="Fit to page" Margin="0,3"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                                            <RadioButton x:Name="RbZoom" GroupName="PdfZoom"
                                                                         Content="Zoom" IsChecked="True"
                                                                         VerticalAlignment="Center"/>
                                                            <TextBox x:Name="TxtZoom" Text="100" Width="52" Height="22"
                                                                     Margin="8,0,4,0" VerticalContentAlignment="Center"
                                                                     IsEnabled="{Binding IsChecked, ElementName=RbZoom}"/>
                                                            <TextBlock Text="% size" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Processing">
                                                    <StackPanel>
                                                        <TextBlock Text="Graphics processing" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbHiddenLine" Height="24" SelectedIndex="0">
                                                            <sys:String>Vector Processing</sys:String>
                                                            <sys:String>Raster Processing</sys:String>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Appearance">
                                                    <StackPanel>
                                                        <TextBlock Text="Raster quality" Margin="0,0,0,4"/>
                                                        <ComboBox x:Name="CmbRaster" Height="24" SelectedIndex="2">
                                                            <sys:String>Low</sys:String>
                                                            <sys:String>Medium</sys:String>
                                                            <sys:String>High</sys:String>
                                                            <sys:String>Presentation</sys:String>
                                                        </ComboBox>
                                                        <TextBlock Text="Colors" Margin="0,8,0,4"/>
                                                        <ComboBox x:Name="CmbColors" Height="24" SelectedIndex="0">
                                                            <sys:String>Color</sys:String>
                                                            <sys:String>Grayscale</sys:String>
                                                            <sys:String>Black Line</sys:String>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <GroupBox Header="Options">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ChkViewLinksBlue" Style="{StaticResource Row}"
                                                                  Content="View links in blue"/>
                                                        <CheckBox x:Name="ChkHideRefPlanes" Style="{StaticResource Row}"
                                                                  Content="Hide ref/work planes" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkHideScopeBoxes" Style="{StaticResource Row}"
                                                                  Content="Hide scope boxes" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkHideCropBound" Style="{StaticResource Row}"
                                                                  Content="Hide crop boundaries"/>
                                                        <CheckBox x:Name="ChkHideUnrefTags" Style="{StaticResource Row}"
                                                                  Content="Hide unreferenced view tags"/>
                                                        <CheckBox x:Name="ChkMaskCoincident" Style="{StaticResource Row}"
                                                                  Content="Mask coincident lines"/>
                                                        <CheckBox x:Name="ChkRegionEdges" Style="{StaticResource Row}"
                                                                  Content="Region edges mask coincident lines"/>
                                                        <CheckBox x:Name="ChkReplaceHalftone" Style="{StaticResource Row}"
                                                                  Content="Replace halftone with thin lines"/>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Page setup">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ChkUseSheetSize" Style="{StaticResource Row}"
                                                                  Content="Use sheet size from title block" IsChecked="True"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="Paper size" Width="80" VerticalAlignment="Center"/>
                                                            <ComboBox x:Name="CmbPaperSize" Width="150" Height="24"
                                                                      IsEnabled="{Binding IsChecked, ElementName=ChkUseSheetSize, Converter={x:Null}}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="Orientation" Width="80" VerticalAlignment="Center"/>
                                                            <ComboBox x:Name="CmbOrientation" Width="150" Height="24" SelectedIndex="0">
                                                                <sys:String>Auto</sys:String>
                                                                <sys:String>Portrait</sys:String>
                                                                <sys:String>Landscape</sys:String>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Combine">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ChkCombinePDF" Style="{StaticResource Row}"
                                                                  Content="Combine selected sheets into a single PDF"/>
                                                        <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                                                            <TextBlock Text="File name" Width="66" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="TxtCombinedName" Width="200" Height="22"
                                                                     VerticalContentAlignment="Center"
                                                                     IsEnabled="{Binding IsChecked, ElementName=ChkCombinePDF}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- ===== DWG ===== -->
                                <TabItem Header="DWG">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="Export setup" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="CmbDwgSetup" Height="24" Width="320" HorizontalAlignment="Left"
                                                  ToolTip="Uses the DWG export setups saved in this Revit model"/>
                                        <TextBlock Text="File version" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>
                                        <ComboBox x:Name="CmbDwgVersion" Height="24" Width="320" HorizontalAlignment="Left"
                                                  SelectedIndex="4">
                                            <sys:String>AutoCAD 2000</sys:String>
                                            <sys:String>AutoCAD 2004</sys:String>
                                            <sys:String>AutoCAD 2007</sys:String>
                                            <sys:String>AutoCAD 2010</sys:String>
                                            <sys:String>AutoCAD 2013</sys:String>
                                            <sys:String>AutoCAD 2018</sys:String>
                                        </ComboBox>
                                        <CheckBox x:Name="ChkDwgMergeViews" Style="{StaticResource Row}" Margin="0,14,0,0"
                                                  Content="Merge views into a single DWG file" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDwgSharedCoords" Style="{StaticResource Row}"
                                                  Content="Use shared coordinates" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDwgXrefViews" Style="{StaticResource Row}"
                                                  Content="Export views on sheets as external references"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- ===== DGN ===== -->
                                <TabItem Header="DGN">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="Export setup" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="CmbDgnSetup" Height="24" Width="320" HorizontalAlignment="Left"/>
                                        <CheckBox x:Name="ChkDgnSharedCoords" Style="{StaticResource Row}" Margin="0,14,0,0"
                                                  Content="Use shared coordinates"/>
                                        <CheckBox x:Name="ChkDgnMergeViews" Style="{StaticResource Row}"
                                                  Content="Merge views into a single DGN file"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- ===== DWF ===== -->
                                <TabItem Header="DWF">
                                    <StackPanel Margin="12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Type" Width="90" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbDwfType" Width="200" Height="24" SelectedIndex="0">
                                                <sys:String>DWF</sys:String>
                                                <sys:String>DWFx</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Image quality" Width="90" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbDwfQuality" Width="200" Height="24" SelectedIndex="2">
                                                <sys:String>Low</sys:String>
                                                <sys:String>Medium</sys:String>
                                                <sys:String>High</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkDwfMerge" Style="{StaticResource Row}"
                                                  Content="Combine selected views/sheets into a single DWF"/>
                                        <CheckBox x:Name="ChkDwfModelGeom" Style="{StaticResource Row}"
                                                  Content="Export object data (model geometry)"/>
                                        <CheckBox x:Name="ChkDwfRoomsAreas" Style="{StaticResource Row}"
                                                  Content="Export rooms and areas as objects"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- ===== NWC ===== -->
                                <TabItem Header="NWC">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <GroupBox Header="Export scope">
                                                    <StackPanel>
                                                        <RadioButton x:Name="RbNwcScopeModel" GroupName="NwcScope"
                                                                     Content="Entire model" Margin="0,3"/>
                                                        <RadioButton x:Name="RbNwcScopeView" GroupName="NwcScope"
                                                                     Content="3D view" IsChecked="True" Margin="0,3"/>
                                                        <ComboBox x:Name="CmbNwc3DView" Height="24" Margin="18,2,0,4"
                                                                  IsEnabled="{Binding IsChecked, ElementName=RbNwcScopeView}"
                                                                  ToolTip="Which 3D view to export"/>
                                                        <TextBlock Text="File name" Margin="0,4,0,3"/>
                                                        <TextBox x:Name="TxtNwcName" Height="24"
                                                                 VerticalContentAlignment="Center"
                                                                 ToolTip="Base name for the .nwc file"/>
                                                        <TextBlock Text="NWC always exports 3D geometry - it ignores the sheets picked on the Selection tab."
                                                                   Foreground="#FF9A6A00" TextWrapping="Wrap"
                                                                   FontSize="11" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Coordinates">
                                                    <StackPanel>
                                                        <ComboBox x:Name="CmbNwcCoords" Height="24" SelectedIndex="0">
                                                            <sys:String>Shared</sys:String>
                                                            <sys:String>Internal</sys:String>
                                                        </ComboBox>
                                                        <CheckBox x:Name="ChkNwcDivideLevels" Style="{StaticResource Row}"
                                                                  Content="Divide file into levels" IsChecked="True" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Faceting">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Faceting factor" VerticalAlignment="Center" Width="100"/>
                                                        <TextBox x:Name="TxtNwcFaceting" Text="1.0" Width="70" Height="22"
                                                                 VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <GroupBox Header="Convert">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ChkNwcExportProps" Style="{StaticResource Row}"
                                                                  Content="Convert element properties"/>
                                                        <CheckBox x:Name="ChkNwcExportLinks" Style="{StaticResource Row}"
                                                                  Content="Convert linked files"/>
                                                        <CheckBox x:Name="ChkNwcLinkedCAD" Style="{StaticResource Row}"
                                                                  Content="Convert linked CAD formats" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkNwcExportParts" Style="{StaticResource Row}"
                                                                  Content="Convert element parts"/>
                                                        <CheckBox x:Name="ChkNwcLights" Style="{StaticResource Row}"
                                                                  Content="Convert lights"/>
                                                        <CheckBox x:Name="ChkNwcRoomAsAttr" Style="{StaticResource Row}"
                                                                  Content="Convert room as attribute" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkNwcRoomGeometry" Style="{StaticResource Row}"
                                                                  Content="Convert room geometry" IsChecked="True"/>
                                                    </StackPanel>
                                                </GroupBox>

                                                <GroupBox Header="Data">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="Parameters" Width="80" VerticalAlignment="Center"/>
                                                            <ComboBox x:Name="CmbNwcParameters" Width="140" Height="24" SelectedIndex="0">
                                                                <sys:String>All</sys:String>
                                                                <sys:String>Elements</sys:String>
                                                                <sys:String>None</sys:String>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <CheckBox x:Name="ChkNwcElementIds" Style="{StaticResource Row}"
                                                                  Content="Export element Ids" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkNwcUrls" Style="{StaticResource Row}"
                                                                  Content="Export URLs" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkNwcMissingMats" Style="{StaticResource Row}"
                                                                  Content="Try to find missing materials" IsChecked="True"/>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- ===== IFC ===== -->
                                <TabItem Header="IFC">
                                    <StackPanel Margin="12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="IFC version" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbIfcVersion" Width="240" Height="24" SelectedIndex="1">
                                                <sys:String>IFC2x2</sys:String>
                                                <sys:String>IFC2x3 Coordination View 2.0</sys:String>
                                                <sys:String>IFC2x3 Basic FM Handover</sys:String>
                                                <sys:String>IFC4 Reference View</sys:String>
                                                <sys:String>IFC4 Design Transfer View</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Space boundaries" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbIfcSpaceBound" Width="240" Height="24" SelectedIndex="0">
                                                <sys:String>None</sys:String>
                                                <sys:String>1st Level</sys:String>
                                                <sys:String>2nd Level</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkIfcSplitWalls" Style="{StaticResource Row}" Content="Split walls and columns by level"/>
                                        <CheckBox x:Name="ChkIfcExportBase" Style="{StaticResource Row}" Content="Export base quantities"/>
                                        <CheckBox x:Name="ChkIfcCurrentView" Style="{StaticResource Row}"
                                                  Content="Export only elements visible in the view below" IsChecked="True"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="View" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbIfcView" Width="240" Height="24"
                                                      IsEnabled="{Binding IsChecked, ElementName=ChkIfcCurrentView}"
                                                      ToolTip="3D view used to filter the exported elements"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="File name" Width="100" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtIfcName" Width="240" Height="24"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <!-- ===== IMG ===== -->
                                <TabItem Header="IMG">
                                    <StackPanel Margin="12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="File type" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbImgType" Width="200" Height="24" SelectedIndex="0">
                                                <sys:String>PNG</sys:String>
                                                <sys:String>JPEG</sys:String>
                                                <sys:String>TIFF</sys:String>
                                                <sys:String>BMP</sys:String>
                                                <sys:String>TARGA</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Image size" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbImgFit" Width="140" Height="24" SelectedIndex="0">
                                                <sys:String>Fit to</sys:String>
                                                <sys:String>Zoom to</sys:String>
                                            </ComboBox>
                                            <TextBox x:Name="TxtImgPixels" Text="2000" Width="70" Height="24" Margin="8,0,4,0"
                                                     VerticalContentAlignment="Center"/>
                                            <TextBlock Text="pixels / DPI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Direction" Width="100" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbImgDirection" Width="200" Height="24" SelectedIndex="0">
                                                <sys:String>Horizontal</sys:String>
                                                <sys:String>Vertical</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Text="Shading follows each view's own display style."
                                                   Foreground="#FF707070" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- ===== FILE NAME ===== -->
                                
                            </TabControl>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtStatusFmt" VerticalAlignment="Center" Foreground="#FF404040"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBack2" Style="{StaticResource NavButton}" Content="Back" Margin="0,0,6,0"/>
                            <Button x:Name="BtnNext2" Style="{StaticResource NavButton}" Content="Next"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 3 : CREATE                                               -->
            <!-- ============================================================ -->
            <TabItem Header="Create">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Output folder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFolder" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource FlatButton}"
                                    Content="Browse..." Margin="6,0,0,0" Height="26"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Style="{StaticResource FlatButton}"
                                    Content="Open" Margin="6,0,0,0" Height="26"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Output options">
                        <StackPanel>
                            <CheckBox x:Name="ChkSubfolderPerFormat" Style="{StaticResource Row}"
                                      Content="Create a sub-folder per format (PDF / DWG / ...)" IsChecked="True"/>
                            <CheckBox x:Name="ChkSubfolderDate" Style="{StaticResource Row}"
                                      Content="Create a sub-folder with today's date"/>
                            <CheckBox x:Name="ChkSubfolderPerSeries" Style="{StaticResource Row}"
                                      Content="Create a sub-folder per group"
                                      ToolTip="Each sheet is exported into &lt;output&gt;\...\&lt;group&gt;\ instead of one flat folder, using the grouping parameter chosen on the Selection tab. Only applies to sheets, and has no effect on Combined PDF / Merged DWF / NWC / IFC, since those produce a single file."/>
                            <CheckBox x:Name="ChkOverwrite" Style="{StaticResource Row}"
                                      Content="Overwrite existing files" IsChecked="True"/>
                            <CheckBox x:Name="ChkOpenWhenDone" Style="{StaticResource Row}"
                                      Content="Open output folder when finished" IsChecked="True"/>
                            <CheckBox x:Name="ChkLog" Style="{StaticResource Row}"
                                      Content="Write a CSV log next to the exported files"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Summary / log" Margin="0,0,0,8">
                        <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="11"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </GroupBox>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="Progress" Grid.Column="0" Height="18" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="TxtProgress" Grid.Column="1" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Text="Ready" MinWidth="220"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <TextBlock x:Name="TxtStatusCreate" VerticalAlignment="Center" Foreground="#FF404040"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBack3" Style="{StaticResource NavButton}" Content="Back" Margin="0,0,6,0"/>
                            <Button x:Name="BtnCancelExport" Style="{StaticResource NavButton}" Content="Cancel"
                                    Margin="0,0,6,0" IsEnabled="False"/>
                            <Button x:Name="BtnCreate" Style="{StaticResource NavButton}" Content="Create"
                                    FontWeight="SemiBold" MinWidth="120"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
