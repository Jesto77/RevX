<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Renamer"
        Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E28"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B3A"/>
            <Setter Property="Foreground" Value="#FFEFEFEF"/>
            <Setter Property="BorderBrush" Value="#FF44445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFEFEFEF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF9A9AB0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3A3A50"/>
            <Setter Property="Foreground" Value="#FFEFEFEF"/>
            <Setter Property="BorderBrush" Value="#FF55557A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDADAE8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="header_text" Text="Family Renamer"
                       FontSize="20" FontWeight="Bold" Foreground="#FFEFEFEF"/>
            <TextBlock x:Name="category_text" Text=""
                       FontSize="13" Foreground="#FF8FD3FF"
                       Margin="14,8,0,0"/>
        </DockPanel>

        <!-- rename controls -->
        <Border Grid.Row="1" Background="#FF26263A" CornerRadius="8"
                Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Label Content="PREFIX"/>
                    <TextBox x:Name="prefix_tb"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <Label Content="SUFFIX"/>
                    <TextBox x:Name="suffix_tb"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <Label Content="FIND"/>
                    <TextBox x:Name="find_tb"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <Label Content="REPLACE WITH"/>
                    <TextBox x:Name="replace_tb"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Width="130">
                    <Label Content="CASE"/>
                    <ComboBox x:Name="case_cb">
                        <ComboBoxItem Content="Keep as is" IsSelected="True"/>
                        <ComboBoxItem Content="UPPERCASE"/>
                        <ComboBoxItem Content="lowercase"/>
                        <ComboBoxItem Content="Title Case"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- notepad + selection controls -->
        <Border Grid.Row="2" Background="#FF26263A" CornerRadius="8"
                Padding="12" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="notepad_btn" Content="📝  EDIT IN NOTEPAD"
                            Width="180" FontWeight="Bold"
                            Background="#FF3A5070" BorderBrush="#FF5A7AA8"/>
                    <TextBlock Text="Opens checked names in Notepad - edit each line freely, save and close to apply back here."
                               Foreground="#FF9A9AB0" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextWrapping="Wrap" MaxWidth="430"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button x:Name="all_btn" Content="All" Width="56" Margin="0,0,6,0"/>
                    <Button x:Name="none_btn" Content="None" Width="56" Margin="0,0,6,0"/>
                    <Button x:Name="invert_btn" Content="Invert" Width="56"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- list -->
        <Border Grid.Row="3" Background="#FF26263A" CornerRadius="8" Padding="4">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,6,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="CURRENT NAME"
                               Foreground="#FF9A9AB0" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="NEW NAME (PREVIEW)"
                               Foreground="#FF9A9AB0" FontSize="11" FontWeight="Bold"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="rows_panel" Margin="6,0,6,6"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- footer -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="status_text" Text=""
                       Foreground="#FF9A9AB0" FontSize="13"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="cancel_btn" Content="Cancel" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="apply_btn" Content="APPLY RENAME"
                        Width="160" Background="#FF2E7D52"
                        BorderBrush="#FF3FA76E" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
