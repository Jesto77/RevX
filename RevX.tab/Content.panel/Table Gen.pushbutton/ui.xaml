<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TableGen - Excel to Revit Schedule"
        Height="700" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E28"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B3A"/>
            <Setter Property="Foreground" Value="#FFEFEFEF"/>
            <Setter Property="BorderBrush" Value="#FF44445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFEFEFEF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF9A9AB0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3A3A50"/>
            <Setter Property="Foreground" Value="#FFEFEFEF"/>
            <Setter Property="BorderBrush" Value="#FF55557A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="TableGen" FontSize="20" FontWeight="Bold"
                       Foreground="#FFEFEFEF" DockPanel.Dock="Left"/>
            <TextBlock Text="  Excel / CSV  →  native Revit Schedule"
                       FontSize="13" Foreground="#FF8FD3FF"
                       VerticalAlignment="Bottom" Margin="8,0,0,2"/>
        </DockPanel>

        <!-- source file -->
        <Border Grid.Row="1" Background="#FF26263A" CornerRadius="8"
                Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Label Content="SOURCE FILE (.xlsx / .csv)"/>
                    <TextBox x:Name="path_tb" IsReadOnly="True"
                             Text="no file selected - click Browse"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"
                            VerticalAlignment="Bottom">
                    <Button x:Name="browse_btn" Content="📂  Browse..."
                            Width="120" FontWeight="Bold"
                            Background="#FF3A5070" BorderBrush="#FF5A7AA8"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Width="170" Margin="0,0,8,0">
                    <Label Content="WORKSHEET"/>
                    <ComboBox x:Name="sheet_cb"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button x:Name="paste_btn" Content="📋  Paste from clipboard"
                            Width="170"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- output settings -->
        <Border Grid.Row="2" Background="#FF26263A" CornerRadius="8"
                Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="200" Margin="0,0,12,0">
                    <Label Content="SCHEDULE NAME"/>
                    <TextBox x:Name="name_tb" Text="New Table"/>
                </StackPanel>
                <StackPanel Width="160" Margin="0,0,12,0">
                    <Label Content="OUTPUT"/>
                    <TextBox Text="Revit Schedule (native)" IsReadOnly="True"
                             Background="#FF222234" Foreground="#FF8FD3FF"/>
                </StackPanel>
                <StackPanel Width="160" Margin="0,0,12,0">
                    <Label Content="AREA TO IMPORT"/>
                    <ComboBox x:Name="area_cb">
                        <ComboBoxItem Content="Entire sheet" IsSelected="True"/>
                        <ComboBoxItem Content="Print area (Excel)"/>
                        <ComboBoxItem Content="Custom range"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Width="110" Margin="0,0,12,0">
                    <Label Content="RANGE (e.g. A1:F40)"/>
                    <TextBox x:Name="range_tb" Text="" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Width="80" Margin="0,0,12,0">
                    <Label Content="COL W (mm)"/>
                    <TextBox x:Name="colw_tb" Text="40"/>
                </StackPanel>
                <StackPanel Width="80" Margin="0,0,12,0">
                    <Label Content="ROW H (mm)"/>
                    <TextBox x:Name="rowh_tb" Text="8"/>
                </StackPanel>
                <StackPanel Width="70" Margin="0,0,12,0">
                    <Label Content="SCALE %"/>
                    <TextBox x:Name="scale_tb" Text="100"/>
                </StackPanel>
                <StackPanel Width="80">
                    <Label Content="IMG SIZE (mm)"/>
                    <TextBox x:Name="imgsize_tb" Text="20"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- preview -->
        <Border Grid.Row="3" Background="#FF26263A" CornerRadius="8" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,2,6,6">
                    <TextBlock Text="TABLES LINKED IN THIS PROJECT (TableGen)"
                               Foreground="#FF9A9AB0" FontSize="11"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="remove_btn"
                                Content="✕  Remove from list"
                                Width="150" Margin="0,0,8,0"
                                Background="#FF5A3A3A" BorderBrush="#FF8A5A5A"/>
                        <Button x:Name="reloadfrom_btn"
                                Content="📂  Reload from..."
                                Width="140" Margin="0,0,8,0"
                                Background="#FF4A4A66" BorderBrush="#FF6A6A8E"/>
                        <!-- Resize rows &amp; images -->
                        <Button x:Name="resize_btn"
                                Content="📐  Resize rows &amp; images"
                                Width="180" Margin="0,0,8,0"
                                Background="#FF6B4A2E" BorderBrush="#FFA7743F"
                                FontWeight="Bold"
                                ToolTip="Set a uniform row height for the selected schedule(s) and rescale all images to match. Re-imports from source file."/>
                        <!-- NEW: Split into parts -->
                        <Button x:Name="split_btn"
                                Content="✂  Split into parts..."
                                Width="160" Margin="0,0,8,0"
                                Background="#FF4A2E6B" BorderBrush="#FF7A4FA7"
                                FontWeight="Bold"
                                ToolTip="Split the selected schedule into N equal parts (e.g. 2, 3, 4). The first 3 rows are repeated as header in every part. Row heights are kept from Excel so images stay UNIFORM. Named 'Name_Sheet 01', 'Name_Sheet 02', etc."/>
                        <!-- Duplicate button -->
                        <Button x:Name="duplicate_btn"
                                Content="📋  Duplicate selected"
                                Width="170" Margin="0,0,8,0"
                                Background="#FF2E6B3A" BorderBrush="#FF3FA75A"
                                FontWeight="Bold"
                                ToolTip="Create a copy of the selected schedule(s) from the same source file. Auto-names as 'Name (2)', 'Name (3)', etc."/>
                        <Button x:Name="reload_btn"
                                Content="⟳  Reload selected from Excel"
                                Width="210"
                                Background="#FF3A5070" BorderBrush="#FF5A7AA8"
                                FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="preview_host"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- footer -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="status_text" Text="Browse an Excel or CSV file to begin."
                       Foreground="#FF9A9AB0" FontSize="13"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="cancel_btn" Content="Cancel" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="create_btn" Content="CREATE IN REVIT"
                        Width="190" Background="#FF2E7D52"
                        BorderBrush="#FF3FA76E" FontWeight="Bold"
                        IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>