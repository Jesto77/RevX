<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RevitBot"
    Width="420" Height="560"
    WindowStartupLocation="Manual"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent">

    <Grid x:Name="RootGrid">
        <!-- MASCOT MODE -->
        <Grid x:Name="MascotGrid" Visibility="Visible" Cursor="Hand">
            <Ellipse x:Name="MascotCircle" Width="64" Height="64"
                     VerticalAlignment="Bottom" HorizontalAlignment="Right"
                     Margin="0,0,0,0" Fill="#0077B6"/>
            <Ellipse x:Name="MascotRing" Width="68" Height="68"
                     VerticalAlignment="Bottom" HorizontalAlignment="Right"
                     Margin="0,0,-2,-2"
                     Stroke="#48CAE4" StrokeThickness="2" Fill="Transparent"/>
            <TextBlock x:Name="MascotFace" Text="RB" FontSize="20" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,16,16"/>
            <Ellipse x:Name="OnlineDot" Width="14" Height="14"
                     VerticalAlignment="Bottom" HorizontalAlignment="Right"
                     Margin="0,0,2,2" Fill="#4CAF50"
                     Stroke="#1E1E2E" StrokeThickness="2"/>
        </Grid>

        <!-- CHAT MODE -->
        <Border x:Name="ChatBorder" Visibility="Collapsed"
                Background="#1E1E2E" CornerRadius="16"
                BorderBrush="#0077B6" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#0D1B2A">
                    <Grid Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="HeaderAvatar" Grid.Column="0"
                                 Width="36" Height="36" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Fill="#0077B6"/>
                        <TextBlock x:Name="HeaderAvatarText" Grid.Column="0"
                                   Text="RB" FontSize="14" FontWeight="Bold" Foreground="White"
                                   Margin="12,0,10,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RevitBot" FontSize="15" FontWeight="Bold"
                                       Foreground="#48CAE4"/>
                            <TextBlock Text="Online" FontSize="10" Foreground="#4CAF50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MinimizeBtn" Content="_" Width="30" Height="30"
                                    Background="Transparent" Foreground="#888" BorderThickness="0"
                                    FontSize="16" Margin="0,0,2,0"/>
                            <Button x:Name="CloseBtn" Content="X" Width="30" Height="30"
                                    Background="Transparent" Foreground="#888" BorderThickness="0"
                                    FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chat messages -->
                <ScrollViewer x:Name="ChatScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E2E" Padding="4">
                    <StackPanel x:Name="ChatPanel" Margin="6,8,6,8"/>
                </ScrollViewer>

                <!-- Input area -->
                <Grid Grid.Row="2" Background="#0D1B2A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             Background="#1B2838" Foreground="#E0E0E0"
                             BorderThickness="0" Margin="10,8,4,8"
                             Padding="10,6" FontSize="14"
                             VerticalContentAlignment="Center"
                             AcceptsReturn="False"/>
                    <Button x:Name="SendBtn" Grid.Column="1" Content="Send"
                            Background="#0077B6" Foreground="White"
                            BorderThickness="0" Margin="4,8,10,8"
                            Padding="14,6" FontSize="13" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>