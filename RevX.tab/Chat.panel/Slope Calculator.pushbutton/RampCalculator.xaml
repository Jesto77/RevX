<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ramp Slope Calculator"
    Height="800" Width="740"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="#F5F7FA"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="Gray50" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Gray100" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Gray200" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Gray400" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Gray600" Color="#475569"/>
        <SolidColorBrush x:Key="Gray800" Color="#1E293B"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Gray50}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#4F46E5" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Ramp Slope Calculator" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Calculate ramp dimensions • Convert %, ratio, degrees • Check compliance" FontSize="12" Foreground="#DDD6FE" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Gray100}" Padding="20,12" BorderBrush="{StaticResource Gray200}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecondaryButton}" Width="100"/>
            </StackPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="TabControl" Background="Transparent" BorderThickness="0" Padding="15">

            <!-- TAB 1: RAMP CALCULATOR -->
            <TabItem Header="📐  Ramp Calculator">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">

                        <!-- Input Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Enter Ramp Dimensions or Ratio" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gray800}" Margin="0,0,0,4"/>
                                <TextBlock Text="Enter Rise + Ratio (e.g. 450 mm &amp; 1:12), or enter Rise + Run." Foreground="{StaticResource Gray600}" FontSize="12" Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Rise -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Rise (Height)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtRise" />
                                            <TextBlock x:Name="LblRiseUnit" Text="mm" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Gray400}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Run -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Run (Horizontal Length)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtRun" />
                                            <TextBlock x:Name="LblRunUnit" Text="mm" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Gray400}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Slope Length -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Slope Length (Hypotenuse)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtSlopeLen" />
                                            <TextBlock x:Name="LblSlopeUnit" Text="mm" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Gray400}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Ratio (1:X) -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Ratio (1:X or e.g. 1:12)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRatio" ToolTip="Type 12 or 1:12"/>
                                    </StackPanel>

                                    <!-- Ratio Preset Dropdown -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="Quick Ratio Presets" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbPreset" SelectedIndex="0">
                                            <ComboBoxItem Content="-- Custom Ratio --" Tag="custom"/>
                                            <ComboBoxItem Content="1:12 (ADA Max Ramp - 8.33%)" Tag="12"/>
                                            <ComboBoxItem Content="1:15 (Comfortable - 6.67%)" Tag="15"/>
                                            <ComboBoxItem Content="1:20 (Best Practice - 5.00%)" Tag="20"/>
                                            <ComboBoxItem Content="1:10 (Steep Ramp - 10.00%)" Tag="10"/>
                                            <ComboBoxItem Content="1:8 (Max Steepness - 12.50%)" Tag="8"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Unit -->
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="Unit of Measure" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbUnit" SelectedIndex="0">
                                            <ComboBoxItem Content="mm"/>
                                            <ComboBoxItem Content="cm"/>
                                            <ComboBoxItem Content="m"/>
                                            <ComboBoxItem Content="in"/>
                                            <ComboBoxItem Content="ft"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button x:Name="BtnCalculate" Content="⚡ Calculate" Style="{StaticResource PrimaryButton}" Width="140" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnReset" Content="🗑 Clear" Style="{StaticResource SecondaryButton}" Width="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Results Panel -->
                        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="✓ Calculation Results" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="3" Rows="2">
                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="RISE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResRise" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock x:Name="LblResRiseUnit" Text="mm" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="RUN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResRun" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock x:Name="LblResRunUnit" Text="mm" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SLOPE LENGTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResSlope" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock x:Name="LblResSlopeUnit" Text="mm" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="GRADIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResGradient" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="ANGLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResAngle" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock Text="degrees" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ResultCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="RATIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="LblResRatio" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                                <TextBlock Text="rise : run" FontSize="11" Foreground="{StaticResource Gray400}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Compliance Banner -->
                            <Border x:Name="ComplianceBorder" Background="#DCFCE7" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2" CornerRadius="8" Padding="15" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#BBF7D0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblComplianceIcon" Text="OK" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#065F46"/>
                                    </Border>
                                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblComplianceTitle" Text="Compliance Status" FontWeight="Bold" FontSize="13" Foreground="#065F46"/>
                                        <TextBlock x:Name="LblComplianceDesc" Text="" FontSize="11" Foreground="#065F46" TextWrapping="Wrap" MaxWidth="600" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: SLOPE CONVERTER -->
            <TabItem Header="🔄  Slope Converter">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Convert from Percentage (%)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Slope Percentage" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtConvPct" />
                                            <TextBlock Text="%" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Gray400}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="BtnConvPct" Grid.Column="2" Content="Convert" Style="{StaticResource PrimaryButton}" Width="110" VerticalAlignment="Bottom"/>
                                </Grid>

                                <UniformGrid x:Name="PctResults" Columns="3" Visibility="Collapsed" Margin="0,15,0,0">
                                    <Border Background="#6366F1" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PERCENTAGE" FontSize="10" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblPctPct" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0EA5E9" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RATIO" FontSize="10" Foreground="#BAE6FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblPctRatio" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#10B981" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DEGREES" FontSize="10" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblPctDeg" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Convert from Ratio (1:X)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Rise" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRatioRise" Text="1" Width="80"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Run (for 1:12, enter 12)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRatioRun" />
                                    </StackPanel>
                                    <Button x:Name="BtnConvRatio" Grid.Column="4" Content="Convert" Style="{StaticResource PrimaryButton}" Width="110" VerticalAlignment="Bottom"/>
                                </Grid>

                                <UniformGrid x:Name="RatioResults" Columns="3" Visibility="Collapsed" Margin="0,15,0,0">
                                    <Border Background="#6366F1" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PERCENTAGE" FontSize="10" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblRatioPct" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0EA5E9" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RATIO" FontSize="10" Foreground="#BAE6FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblRatioRatio" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#10B981" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DEGREES" FontSize="10" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblRatioDeg" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Convert from Degrees (°)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Slope Angle" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtConvDeg" />
                                            <TextBlock Text="°" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Gray400}" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="BtnConvDeg" Grid.Column="2" Content="Convert" Style="{StaticResource PrimaryButton}" Width="110" VerticalAlignment="Bottom"/>
                                </Grid>

                                <UniformGrid x:Name="DegResults" Columns="3" Visibility="Collapsed" Margin="0,15,0,0">
                                    <Border Background="#6366F1" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PERCENTAGE" FontSize="10" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblDegPct" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0EA5E9" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RATIO" FontSize="10" Foreground="#BAE6FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblDegRatio" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#10B981" CornerRadius="6" Padding="10" Margin="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DEGREES" FontSize="10" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblDegDeg" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: GUIDELINES -->
            <TabItem Header="📋  Guidelines">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ramp Slope Standards" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gray800}" Margin="0,0,0,4"/>
                                <TextBlock Text="Common accessibility &amp; building code requirements." Foreground="{StaticResource Gray600}" FontSize="12" Margin="0,0,0,15"/>

                                <Border Background="{StaticResource Gray100}" Padding="10,8" CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Standard / Use" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Gray800}"/>
                                        <TextBlock Grid.Column="1" Text="Ratio" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Gray800}"/>
                                        <TextBlock Grid.Column="2" Text="Degrees" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Gray800}"/>
                                        <TextBlock Grid.Column="3" Text="Percentage" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Gray800}"/>
                                    </Grid>
                                </Border>

                                <StackPanel>
                                    <Border BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1" Padding="10,10" Background="#EEF2FF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ADA / DDA Wheelchair Ramp" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="1 : 12" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="4.76°" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="8.33%" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1" Padding="10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="UK Building Regs (Part M)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="1:12 – 1:20" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="2.86° – 4.76°" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="5% – 8.33%" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1" Padding="10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Preferred / Best Practice" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="1 : 20" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="2.86°" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="5%" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>